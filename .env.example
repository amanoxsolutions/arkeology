# arkeology — environment configuration
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
# Do NOT embed help text in a variable's value — keep comments on their own line.

# ── Required ──────────────────────────────────────────────────────────────────

AWS_REGION=eu-west-1
ARTIFACT_BUCKET=your-artifact-bucket
VECTORS_BUCKET=your-vectors-bucket
VECTORS_INDEX=your-vectors-index

# ── Optional ──────────────────────────────────────────────────────────────────

# Named AWS profile — leave unset to use the default credential chain
# AWS_PROFILE=your-profile

# S3 key prefix for all artifact writes — must not be empty
# WRITE_PREFIX=artifacts

# Additional read scopes (comma-separated S3 key prefixes, no spaces in each prefix)
# Leave blank or comment out if you only read from your own write prefix
# READ_PREFIXES=shared/org,shared/platform

# Bedrock embedding model — change only if you are not using Titan Text v2
# BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Embedding dimensions — must match your S3 Vectors index dimension
# BEDROCK_EMBEDDING_DIMENSIONS=1024

# Search tuning
# SEARCH_FETCH_TOP_K=25
# SEARCH_MAX_ITERATIONS=3
# SEARCH_DEFAULT_TOP_K=5

# Write performance — increase SECTION_CONCURRENCY for faster bulk imports
# (restart the server after changing this value)
# SECTION_CONCURRENCY=5
# EMBED_MAX_SECTIONS=20
# EMBED_MIN_SECTION_LENGTH=50

# Logging level: DEBUG, INFO, WARNING, or ERROR
# LOG_LEVEL=INFO

# Path to the partial-write failure log
# FAILURE_LOG_PATH=.arkeology_failures.jsonl
