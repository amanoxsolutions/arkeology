# .env.example — copy to .env and fill in your values for local development.
# The .env file is gitignored and never committed.
# Real shell env vars always override values in .env.

# ── Required ─────────────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
ARTIFACT_BUCKET=my-cairn-artifacts-dev
VECTORS_BUCKET=my-cairn-vectors-dev
VECTORS_INDEX=my-cairn-index-dev

# ── Credentials (optional — omit to use default credential chain) ─────────────
# AWS_PROFILE=my-dev-profile

# ── Embedding model ───────────────────────────────────────────────────────────
# BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0   # default
# BEDROCK_EMBEDDING_DIMENSIONS=1024  # must match the dimension of VECTORS_INDEX

# ── Scopes ────────────────────────────────────────────────────────────────────
WRITE_PREFIX=team/project              # default: "artifacts" — must not be empty
# READ_PREFIXES=other-team/,shared/   # comma-separated additional read scopes

# ── Search tuning (optional) ──────────────────────────────────────────────────
# SEARCH_FETCH_TOP_K=25
# SEARCH_MAX_ITERATIONS=3
# SEARCH_DEFAULT_TOP_K=5

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
